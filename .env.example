# URL raw de cursos.json en GitHub (obligatoria en la demostración).
CURSOS_URL=https://raw.githubusercontent.com/<usuario>/<repo>/main/data/cursos.json

# Ollama local
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=openbmb/minicpm5-2b
OLLAMA_NUM_GPU=-1
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=384
OLLAMA_TEMPERATURE=0.2
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT=600
OLLAMA_THINK=false

# Correo (Gmail: contraseña de aplicación, no la clave de la cuenta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
